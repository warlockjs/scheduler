{
  "name": "@warlock.js/scheduler",
  "version": "5.1.0",
  "type": "module",
  "description": "A simple scheduler package to run jobs in scheduled times",
  "main": "./src/index.ts",
  "warlock": {
    "environment": "server"
  },
  "module": "./src/index.ts",
  "typings": "./src/index.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "dayjs": "^1.11.19"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "typescript": "^5.9.3",
    "vitest": "4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/warlockjs/scheduler"
  },
  "keywords": [
    "warlock.js",
    "scheduler",
    "job",
    "cron",
    "time",
    "date",
    "interval",
    "timer",
    "delay",
    "timeout"
  ],
  "author": "hassanzohdy",
  "license": "MIT",
  "packageManager": "pnpm@11.24.0"
}
